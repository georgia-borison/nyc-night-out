ANTHROPIC_API_KEY=
# Only needed if your key is not scoped to a workspace:
ANTHROPIC_WORKSPACE_ID=

# Saved plans (Upstash Redis, added from Vercel's Storage tab).
# Without these, plans are saved to data/plans.json locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Places (Text Search, New API). Without it, Claude suggests places from memory.
GOOGLE_PLACES_API_KEY=

# Sign in with Google + calendar invites (Google Cloud > APIs & Services > Credentials,
# an OAuth client ID of type "Web application"). AUTH_SECRET is any long random string;
# generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
