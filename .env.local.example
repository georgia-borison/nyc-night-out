ANTHROPIC_API_KEY=
# Only needed if your key is not scoped to a workspace:
ANTHROPIC_WORKSPACE_ID=

# Saved plans (Upstash Redis, added from Vercel's Storage tab).
# Without these, plans are saved to data/plans.json locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Places (Text Search, New API). Without it, Claude suggests places from memory.
GOOGLE_PLACES_API_KEY=
